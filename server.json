{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yun87457-web/google-ads-transparency-mcp",
  "title": "Google Ads Transparency Scraper & MCP Server",
  "description": "Real-time Google Ads Transparency MCP: Search/YouTube creatives, EU DSA reach & domain checks.",
  "repository": {
    "url": "https://github.com/yun87457-web/google-ads-transparency-mcp",
    "source": "github"
  },
  "version": "1.4.2",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://spiky-closet--google-ads-transparency-scraper.apify.actor/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Apify Bearer token (format: Bearer <YOUR_APIFY_TOKEN>)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "adpulse-google-ads-transparency-mcp",
      "version": "1.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Optional Apify API token for full batch & MCP quota (works keyless in free trial mode)",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
